    "version": "0.2.0",
    "configurations": [
        {
            "name": "flutter_oauth_wasm (wasm)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--web-port",
                "42069",
                "-d",
                "chrome",
                "--wasm"
            ],
            "flutterMode": "debug"
        },
        {
            "name": "flutter_oauth_wasm (no wasm)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--web-port",
                "42069",
                "-d",
                "chrome",
            ],
            "flutterMode": "debug"
        }
    ]
}